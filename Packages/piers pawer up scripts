PowerUp_Pierce (for the pawer up)

using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class PowerUp_Pierce : MonoBehaviour
{
    [SerializeField] private float fallSpeed = 5f;
    [SerializeField] private GameObject spearPrefab;
    [SerializeField] private Vector3 spawnOffset = new Vector3(0f, 0.75f, 0f);

    private Rigidbody rb;
    private bool collected = false;

    private void Awake()
    {
        rb = GetComponent<Rigidbody>();
    }

    private void FixedUpdate()
    {
        rb.velocity = Vector3.down * fallSpeed;
    }

    private void OnTriggerEnter(Collider other)
    {
        if (collected) return;
        if (!other.CompareTag("Paddle")) return;

        collected = true;

        PaddlePierceAbility ability = other.GetComponent<PaddlePierceAbility>();
        if (ability != null)
        {
            ability.SpawnLoadedSpear(spearPrefab, spawnOffset);
        }

        Destroy(gameObject);
    }
}

padel pirec abilaty


using UnityEngine;

public class PaddlePierceAbility : MonoBehaviour
{
    private GameObject loadedSpear;
    private Rigidbody loadedRb;

    [SerializeField] private Vector3 launchDirection = Vector3.up;
    [SerializeField] private float launchForce = 20f;

    public void SpawnLoadedSpear(GameObject prefab, Vector3 offset)
    {
        Vector3 pos = transform.position + offset;
        loadedSpear = Instantiate(prefab, pos, Quaternion.identity);
        loadedSpear.transform.SetParent(transform);
        loadedRb = loadedSpear.GetComponent<Rigidbody>();
        loadedRb.isKinematic = true;
    }

    private void Update()
    {
        if (loadedSpear == null) return;
        if (Input.GetKeyDown(KeyCode.Space))
        {
            Launch();
        }
    }

    private void Launch()
    {
        loadedSpear.transform.SetParent(null);
        loadedRb.isKinematic = false;
        loadedRb.velocity = launchDirection.normalized * launchForce;
        loadedSpear = null;
        loadedRb = null;
    }
}

